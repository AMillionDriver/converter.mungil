# Root .gitignore for Converter_File Repository

# Dependencies
node_modules/
**/node_modules/

# Production Build Outputs
dist/
**/dist/
dist-ssr/
*.local

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# IDE & Editor files
.vscode/
.idea/
.claude/
.mimocode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs & Temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp/
temp/
**/tmp/
**/temp/
