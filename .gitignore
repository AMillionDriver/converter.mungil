# Root .gitignore for Converter_File Repository

# Dependencies
node_modules/
**/node_modules/

# Production & Build Outputs
dist/
**/dist/
dist-ssr/
*.local
.turbo/

# Vite & Tool Caches
.vite/
**/.vite/
.eslintcache/
.eslintcache

# Vitest & Coverage
coverage/
**/coverage/
*.lcov
.vitest/

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# IDE, AI & Editor files
.vscode/
.idea/
.claude/
.mimocode/
.gemini/
.cursor/
.windsurf/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Cloudflare & Vercel Artifacts
.vercel/
.wrangler/

# OS Generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs & Temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp/
temp/
**/tmp/
**/temp/
