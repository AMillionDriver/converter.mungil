#!/bin/sh
echo "🔍 Menjalankan pemeriksaan kualitas kode (Husky pre-commit)..."

cd APP || exit 1

echo "1/3 🎨 Memeriksa format kode (Prettier)..."
npm run format:check || {
  echo "❌ Git commit dibatalkan: Ada file yang belum terformat dengan rapi. Jalankan 'npm run format:write'!"
  exit 1
}

echo "2/3 ⚡ Memeriksa ESLint..."
npm run lint || {
  echo "❌ Git commit dibatalkan: Terdeteksi kesalahan linting (ESLint error)!"
  exit 1
}

echo "3/3 🧪 Memeriksa Unit Tests..."
npm test || {
  echo "❌ Git commit dibatalkan: Ada unit test yang gagal!"
  exit 1
}

echo "✅ Semua pemeriksaan lulus! Melanjutkan commit..."
exit 0
