# ==========================================
# Backend Server Environment Config Template
# Salin file ini menjadi `.env` di folder `APP/server/`
# ==========================================

# Status Lingkungan (development | production)
NODE_ENV=development

# Port Server Fastify
PORT=3000

# Domain Frontend yang diizinkan (CORS Policy)
# Pisahkan dengan koma jika lebih dari satu (contoh: https://mungil.my.id,http://localhost:5173)
ALLOWED_ORIGIN=http://localhost:5173

# Cloudflare Turnstile Secret Key (Private Key - JANGAN DISEBARKAN)
CLOUDFLARE_TURNSTILE_SECRET=YOUR_TURNSTILE_SECRET_KEY

# Cloudflare Turnstile Site Key (Public Key)
CLOUDFLARE_TURNSTILE_SITEKEY=YOUR_TURNSTILE_SITE_KEY
