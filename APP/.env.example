# ==========================================
# Frontend Environment Config Template (APP)
# Salin file ini menjadi `.env` di folder `APP/`
# ==========================================

NODE_ENV=development

# Backend API Endpoint (sesuaikan port jika berbeda)
VITE_API_URL=http://localhost:3000

# Cloudflare Turnstile Site Key (Public Key)
VITE_TURNSTILE_SITEKEY=0x4AAAAAADu46RXWxLxLRnbN

# Google AdSense Monetization
# Ganti dengan Publisher ID resmi Anda saat akun AdSense aktif
VITE_ADSENSE_CLIENT_ID=ca-pub-1234567890123456
VITE_ADSENSE_SLOT_LEFT=1029384756
VITE_ADSENSE_SLOT_RIGHT=5647382910
